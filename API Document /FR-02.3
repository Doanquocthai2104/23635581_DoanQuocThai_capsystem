openapi: 3.0.3
info:
  title: CAB System - FR-02.3 / API-06
  description: 'FR-02.3 - Send trip request to driver. API: API-06. Business Requirement:
    BR-02: Tìm tài xế.'
  version: 1.0.0
servers:
- url: https://api.cabsystem.example.com
  description: Production Server
- url: http://localhost:8080
  description: Local Development Server
tags:
- name: 'BR-02: Tìm tài xế'
  description: Các API phục vụ tìm kiếm, lựa chọn và phân công tài xế.
paths:
  /api/v1/trips/{tripId}/driver-request:
    post:
      tags:
      - 'BR-02: Tìm tài xế'
      summary: Send trip request to driver
      description: Sends a trip request to a selected driver.
      operationId: sendTripRequestToDriver
      security:
      - bearerAuth: []
      parameters:
      - name: tripId
        in: path
        required: true
        schema:
          type: string
        example: TR001
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              required:
              - driverId
              properties:
                driverId:
                  type: string
                  example: DR001
      responses:
        '200':
          description: Trip request sent
          content:
            application/json:
              schema:
                type: object
                properties:
                  success:
                    type: boolean
                    example: true
                  message:
                    type: string
                    example: Operation successful
                  data:
                    type: object
                    additionalProperties: true
        '404':
          description: Trip or driver not found
          content:
            application/json:
              schema:
                type: object
                properties:
                  success:
                    type: boolean
                    example: false
                  errorCode:
                    type: string
                    example: INVALID_REQUEST
                  message:
                    type: string
                    example: Invalid request data
components:
  securitySchemes:
    bearerAuth:
      type: http
      scheme: bearer
      bearerFormat: JWT
