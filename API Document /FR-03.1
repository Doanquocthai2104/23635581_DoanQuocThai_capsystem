openapi: 3.0.3
info:
  title: CAB System - FR-03.1 / API-09
  description: 'FR-03.1 - Accept trip. API: API-09. Business Requirement: BR-03: Thực
    hiện chuyến.'
  version: 1.0.0
servers:
- url: https://api.cabsystem.example.com
  description: Production Server
- url: http://localhost:8080
  description: Local Development Server
tags:
- name: 'BR-03: Thực hiện chuyến'
  description: Các API phục vụ tài xế nhận và thực hiện chuyến.
paths:
  /api/v1/trips/{tripId}/accept:
    post:
      tags:
      - 'BR-03: Thực hiện chuyến'
      summary: Accept trip
      description: Allows a driver to accept a trip request.
      operationId: acceptTrip
      security:
      - bearerAuth: []
      parameters:
      - name: tripId
        in: path
        required: true
        schema:
          type: string
        example: TR001
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              required:
              - driverId
              properties:
                driverId:
                  type: string
                  example: DR001
      responses:
        '200':
          description: Trip accepted
          content:
            application/json:
              schema:
                type: object
                properties:
                  success:
                    type: boolean
                    example: true
                  message:
                    type: string
                    example: Operation successful
                  data:
                    type: object
                    additionalProperties: true
        '409':
          description: Trip is no longer available
          content:
            application/json:
              schema:
                type: object
                properties:
                  success:
                    type: boolean
                    example: false
                  errorCode:
                    type: string
                    example: INVALID_REQUEST
                  message:
                    type: string
                    example: Invalid request data
components:
  securitySchemes:
    bearerAuth:
      type: http
      scheme: bearer
      bearerFormat: JWT
