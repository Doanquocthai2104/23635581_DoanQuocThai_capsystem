openapi: 3.0.3
info:
  title: CAB System - FR-04.3 / API-14
  description: 'FR-04.3 - Notify trip status. API: API-14. Business Requirement: BR-04:
    Theo dõi chuyến.'
  version: 1.0.0
servers:
- url: https://api.cabsystem.example.com
  description: Production Server
- url: http://localhost:8080
  description: Local Development Server
tags:
- name: 'BR-04: Theo dõi chuyến'
  description: Các API phục vụ khách hàng theo dõi trạng thái và thông tin chuyến.
paths:
  /api/v1/trips/{tripId}/status/notify:
    put:
      tags:
      - 'BR-04: Theo dõi chuyến'
      summary: Notify trip status
      description: Updates trip status and notifies the customer about the status
        change.
      operationId: notifyTripStatus
      security:
      - bearerAuth: []
      parameters:
      - name: tripId
        in: path
        required: true
        schema:
          type: string
        example: TR001
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              required:
              - status
              - customerId
              properties:
                status:
                  type: string
                  example: IN_PROGRESS
                customerId:
                  type: string
                  example: CUS001
      responses:
        '200':
          description: Trip status notification sent
          content:
            application/json:
              schema:
                type: object
                properties:
                  success:
                    type: boolean
                    example: true
                  message:
                    type: string
                    example: Operation successful
                  data:
                    type: object
                    additionalProperties: true
        '400':
          description: Invalid status notification data
          content:
            application/json:
              schema:
                type: object
                properties:
                  success:
                    type: boolean
                    example: false
                  errorCode:
                    type: string
                    example: INVALID_REQUEST
                  message:
                    type: string
                    example: Invalid request data
components:
  securitySchemes:
    bearerAuth:
      type: http
      scheme: bearer
      bearerFormat: JWT
