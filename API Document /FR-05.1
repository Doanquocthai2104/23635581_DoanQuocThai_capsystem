openapi: 3.0.3
info:
  title: CAB System - FR-05.1 / API-15
  description: 'FR-05.1 - Calculate trip fare. API: API-15. Business Requirement:
    BR-05: Tính cước & thanh toán.'
  version: 1.0.0
servers:
- url: https://api.cabsystem.example.com
  description: Production Server
- url: http://localhost:8080
  description: Local Development Server
tags:
- name: 'BR-05: Tính cước & thanh toán'
  description: Các API phục vụ tính cước và xử lý thanh toán.
paths:
  /api/v1/trips/{tripId}/fare:
    get:
      tags:
      - 'BR-05: Tính cước & thanh toán'
      summary: Calculate trip fare
      description: Returns the fare information for a completed or active trip.
      operationId: calculateTripFare
      security:
      - bearerAuth: []
      parameters:
      - name: tripId
        in: path
        required: true
        schema:
          type: string
        example: TR001
      responses:
        '200':
          description: Fare calculated
          content:
            application/json:
              schema:
                type: object
                properties:
                  success:
                    type: boolean
                    example: true
                  message:
                    type: string
                    example: Operation successful
                  data:
                    type: object
                    additionalProperties: true
        '404':
          description: Trip not found
          content:
            application/json:
              schema:
                type: object
                properties:
                  success:
                    type: boolean
                    example: false
                  errorCode:
                    type: string
                    example: INVALID_REQUEST
                  message:
                    type: string
                    example: Invalid request data
components:
  securitySchemes:
    bearerAuth:
      type: http
      scheme: bearer
      bearerFormat: JWT
