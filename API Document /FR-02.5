openapi: 3.0.3
info:
  title: CAB System - FR-02.5 / API-08
  description: 'FR-02.5 - Notify customer when no driver is available. API: API-08.
    Business Requirement: BR-02: Tìm tài xế.'
  version: 1.0.0
servers:
- url: https://api.cabsystem.example.com
  description: Production Server
- url: http://localhost:8080
  description: Local Development Server
tags:
- name: 'BR-02: Tìm tài xế'
  description: Các API phục vụ tìm kiếm, lựa chọn và phân công tài xế.
paths:
  /api/v1/notifications/no-driver:
    post:
      tags:
      - 'BR-02: Tìm tài xế'
      summary: Notify customer when no driver is available
      description: Sends a notification to the customer when the system cannot find
        a driver.
      operationId: notifyNoDriver
      security:
      - bearerAuth: []
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              required:
              - tripId
              - customerId
              - message
              properties:
                tripId:
                  type: string
                  example: TR001
                customerId:
                  type: string
                  example: CUS001
                message:
                  type: string
                  example: No available driver was found
      responses:
        '200':
          description: Notification sent
          content:
            application/json:
              schema:
                type: object
                properties:
                  success:
                    type: boolean
                    example: true
                  message:
                    type: string
                    example: Operation successful
                  data:
                    type: object
                    additionalProperties: true
        '400':
          description: Invalid notification data
          content:
            application/json:
              schema:
                type: object
                properties:
                  success:
                    type: boolean
                    example: false
                  errorCode:
                    type: string
                    example: INVALID_REQUEST
                  message:
                    type: string
                    example: Invalid request data
components:
  securitySchemes:
    bearerAuth:
      type: http
      scheme: bearer
      bearerFormat: JWT
