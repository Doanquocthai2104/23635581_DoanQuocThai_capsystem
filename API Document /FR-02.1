openapi: 3.0.3
info:
  title: CAB System - FR-02.1 / API-04
  description: 'FR-02.1 - Get available drivers. API: API-04. Business Requirement:
    BR-02: Tìm tài xế.'
  version: 1.0.0
servers:
- url: https://api.cabsystem.example.com
  description: Production Server
- url: http://localhost:8080
  description: Local Development Server
tags:
- name: 'BR-02: Tìm tài xế'
  description: Các API phục vụ tìm kiếm, lựa chọn và phân công tài xế.
paths:
  /api/v1/drivers/available:
    get:
      tags:
      - 'BR-02: Tìm tài xế'
      summary: Get available drivers
      description: Returns drivers currently available for a requested vehicle type.
      operationId: getAvailableDrivers
      security:
      - bearerAuth: []
      parameters:
      - name: vehicleType
        in: query
        required: true
        schema:
          type: string
          enum:
          - CAR
          - MOTORBIKE
        example: CAR
      responses:
        '200':
          description: Available drivers returned
          content:
            application/json:
              schema:
                type: object
                properties:
                  success:
                    type: boolean
                    example: true
                  message:
                    type: string
                    example: Operation successful
                  data:
                    type: object
                    additionalProperties: true
        '400':
          description: Invalid vehicle type
          content:
            application/json:
              schema:
                type: object
                properties:
                  success:
                    type: boolean
                    example: false
                  errorCode:
                    type: string
                    example: INVALID_REQUEST
                  message:
                    type: string
                    example: Invalid request data
components:
  securitySchemes:
    bearerAuth:
      type: http
      scheme: bearer
      bearerFormat: JWT

